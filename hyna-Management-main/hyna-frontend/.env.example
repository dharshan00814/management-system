# Supabase Configuration
# Replace these with your actual Supabase Project URL and Anon Public Key from:
# Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# WebRTC & Socket.IO Signaling Server Configuration
# Local Development: http://localhost:5050
# Render Production Deployment Example: https://hyna-webrtc-server.onrender.com
VITE_SOCKET_URL=http://localhost:5050
VITE_SFU_SERVER_URL=http://localhost:5050

# Optional TURN Relay Server Configuration (for strict corporate/mobile NAT firewalls)
# VITE_TURN_URL=turn:turn.onrender.com:3478
# VITE_TURN_USERNAME=your-turn-username
# VITE_TURN_PASSWORD=your-turn-password
